<?xml version="1.0" encoding="iso-8859-1"?>
<workspace>
  <project>
    <path>$WS_DIR$/AES_modes/AES.ewp</path>
  </project>
  <project>
    <path>$WS_DIR$/AES_ECBmode_DMA/AES_ECB_DMA.ewp</path>
  </project>
  <project>
    <path>$WS_DIR$/DES_TDES_modes/DES_TDES.ewp</path>
