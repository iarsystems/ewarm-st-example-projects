        <project>AES</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
      <member>
        <project>AES_ECB_DMA</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
      <member>
        <project>DES_TDES</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
      <member>
        <project>TDES_ECB_DMA</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
    </batchDefinition>
  </batchBuild>
</workspace>
