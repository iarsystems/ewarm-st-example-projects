      </member>
      <member>
        <project>DataExchangeInterrupt</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
      <member>
        <project>HyperTerminal_Interrupt</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
      <member>
        <project>SmartCard</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
      <member>
        <project>USART_Printf</project>
        <configuration>STM322xG_EVAL</configuration>
      </member>
    </batchDefinition>
  </batchBuild>
</workspace>
